{
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "node_modules"
  ],
  "config": {
    "default": true,
    "MD032": false,
    "MD024": {
      "siblings_only": true
    },
    "MD013": {
      "line_length": 80,
      "code_blocks": false,
      "tables": false
    }
  }
}
